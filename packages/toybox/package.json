{
  "name": "@vattr/toybox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepack": "node build.js",
    "test": "node build.js && node build-cloudflare.js examples/neighbor && node --import ./src/node-lockdown.js --test test/*.test.js",
    "build": "node build.js",
    "build:cloudflare": "node build-cloudflare.js examples/neighbor",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "typecheck": "tsc -p . --noEmit",
    "wallet": "node build.js && scripts/wallet-service.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "22",
    "@types/ws": "8",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "@endo/errors": "^1.3.1",
    "@endo/eventual-send": "1.5.0",
    "@endo/exo": "^1.7.0",
    "@endo/far": "^1.1.14",
    "@endo/hex": "^1.1.1",
    "@endo/init": "^1.1.13",
    "@endo/marshal": "1.10.0",
    "@endo/pass-style": "1.8.2",
    "@endo/patterns": "^1.9.1",
    "capnweb": "0.12.0",
    "workerd": "1.20261006.1",
    "ws": "8.22.0"
  },
  "files": [
    "build.js",
    "build-cloudflare.js",
    "config.capnp",
    "dist",
    "examples",
    "scripts",
    "src",
    "test",
    "wrangler.jsonc"
