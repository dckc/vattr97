{
  "compilerOptions": {
    "target": "ES2022",
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": [
    "index.js",
    "scripts/**/*.js",
    "src/**/*.js",
    "src/**/*.d.ts",
    "test/**/*.js"
  ]
}
